<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.xwiki.jirapro</groupId>
    <artifactId>jira-pro-parent</artifactId>
    <version>1.0.2-SNAPSHOT</version>
  </parent>
  <artifactId>jira-pro-xip</artifactId>
  <name>JIRA Pro - XIP</name>
  <packaging>xip</packaging>
  <description>Package containing everything needed to install JIRA Pro offline.</description>
  <dependencies>
    <dependency>
      <groupId>com.xwiki.jirapro</groupId>
      <artifactId>jira-pro</artifactId>
      <version>${project.version}</version>
      <type>xar</type>
    </dependency>
  </dependencies>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.xwiki.commons</groupId>
          <artifactId>xwiki-commons-tool-extension-plugin</artifactId>
          <!-- Needs the fix of XCOMMONS-3003, otherwise com.atlassian.sal:sal-api (pulled by the JIRA macro) is
               stored with a wrong id and offline installs fail. 15.10.9 is the first 15.10.x with the fix.
               Don't use 16.0 to 16.3, they don't have it. Can be replaced with ${commons.version} once the parent
               is on a version that includes the fix (15.10.9+ or 16.4.0+). -->
          <version>15.10.9</version>
          <configuration>
            <coreExtensions>
              <!-- We exclude what is already in the WAR. -->
              <coreExtension>
                <groupId>org.xwiki.platform</groupId>
                <artifactId>xwiki-platform-distribution-war-dependencies</artifactId>
                <version>${platform.version}</version>
                <type>pom</type>
              </coreExtension>
            </coreExtensions>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <extensions>
      <!-- Needed to add support for the "xip" packaging. -->
      <extension>
        <groupId>org.xwiki.commons</groupId>
        <artifactId>xwiki-commons-tool-extension-plugin</artifactId>
        <version>15.10.9</version>
      </extension>
    </extensions>
  </build>
</project>
